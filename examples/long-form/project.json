      "bgm": null,
      "sound": "bell"
    },
    {
      "id": "a01",
      "title": "重新开门",
      "kind": "dialogue",
      "chapter": "留下",
      "text": "钥匙还放在花盆底下。那是一种笨拙却固执的信任，像这间屋子始终没有换掉的窗帘。",
      "character": "qiao",
      "background": "bay",
      "next": "a02",
      "choices": [],
      "position": [
        32,
        392
      ],
      "portrait_side": "right",
      "portrait_scale": 1.0,
      "expression": "平静",
      "actors": [],
